# RKE2 Autoscaler Dashboard Configuration
# Copy this file to .env and fill in your values

# Proxmox Connection
PROXMOX_ENDPOINT="https://10.12.0.1:8006/api2/json/"
PROXMOX_USERNAME="root@pam"
PROXMOX_PASSWORD=""

# Dashboard Authentication
DASHBOARD_TOKEN=""
DASHBOARD_PASSWORD=""

# Kubernetes Config
# KUBECONFIG_PATH is set automatically when you use setup wizard
KUBECONFIG_PATH="./kubeconfig"

# Terraform Directory (where your terraform files are)
TERRAFORM_DIR="./"